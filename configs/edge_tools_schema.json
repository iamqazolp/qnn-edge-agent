[
  {
    "type": "function",
    "function": {
      "name": "local_file_search",
      "description": "Search for files in the local workspace directory matching a pattern or extension.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search term or filename pattern, e.g. '*.py' or 'config'."
          },
          "directory": {
            "type": "string",
            "description": "Base directory path to search, e.g. 'src' or '.'."
          },
          "max_results": {
            "type": "integer",
            "description": "Maximum number of file paths to return."
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "git_diff_status",
      "description": "Inspect git repository status and retrieve unstaged or staged diff summary.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "staged": {
            "type": "boolean",
            "description": "Whether to check staged changes or working tree."
          },
          "path": {
            "type": "string",
            "description": "Optional subpath or filename to inspect."
          },
          "summary_only": {
            "type": "boolean",
            "description": "Whether to return only file status summary instead of full patch."
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "sqlite_query",
      "description": "Execute a read-only SQL query against a local SQLite database file.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "db_path": {
            "type": "string",
            "description": "Path to the local SQLite database file."
          },
          "query": {
            "type": "string",
            "description": "SQL query string to execute."
          },
          "params": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional positional query parameters."
          }
        },
        "required": [
          "db_path",
          "query"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "process_monitor",
      "description": "Query running system processes, CPU/memory consumption, and status.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name_filter": {
            "type": "string",
            "description": "Optional process name or executable substring filter."
          },
          "sort_by": {
            "type": "string",
            "enum": [
              "cpu",
              "memory",
              "pid"
            ],
            "description": "Metric to sort returned process list by."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum number of processes to return."
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "calendar_schedule",
      "description": "Schedule or retrieve events and meetings in the local calendar application.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title or summary of the calendar event."
          },
          "start_time": {
            "type": "string",
            "description": "ISO 8601 start timestamp."
          },
          "end_time": {
            "type": "string",
            "description": "ISO 8601 end timestamp."
          },
          "attendees": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of participant email addresses."
          }
        },
        "required": [
          "title",
          "start_time"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "system_clipboard",
      "description": "Read or write text content to the local operating system clipboard.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ],
            "description": "Clipboard operation to perform."
          },
          "content": {
            "type": "string",
            "description": "Text content to write when action is write."
          }
        },
        "required": [
          "action"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "mqtt_publish",
      "description": "Publish a message payload to a specified MQTT broker topic.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "description": "Target MQTT topic path, e.g. sensors/temperature."
          },
          "payload": {
            "type": "string",
            "description": "Message payload string or serialized JSON."
          },
          "qos": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ],
            "description": "Quality of Service level (0=at most once, 1=at least once, 2=exactly once)."
          },
          "retain": {
            "type": "boolean",
            "description": "Whether the message should be retained by the broker."
          }
        },
        "required": [
          "topic",
          "payload"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "gpio_set",
      "description": "Configure pin direction and set digital output level on a GPIO pin.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "pin": {
            "type": "integer",
            "description": "GPIO pin index (0 to 64)."
          },
          "state": {
            "type": "string",
            "enum": [
              "HIGH",
              "LOW"
            ],
            "description": "Logic level to drive on the pin."
          },
          "mode": {
            "type": "string",
            "enum": [
              "output",
              "input_pullup",
              "input_pulldown"
            ],
            "description": "Pin direction and pull resistor configuration."
          }
        },
        "required": [
          "pin",
          "state"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "set_telemetry_threshold",
      "description": "Configure alert boundaries and notification channels for an edge sensor metric.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "sensor_id": {
            "type": "string",
            "description": "Unique identifier of the physical or virtual sensor."
          },
          "metric": {
            "type": "string",
            "enum": [
              "temperature",
              "humidity",
              "pressure",
              "vibration",
              "voltage"
            ],
            "description": "Physical quantity monitored."
          },
          "min_value": {
            "type": "number",
            "description": "Lower safety threshold; values below trigger an underflow alert."
          },
          "max_value": {
            "type": "number",
            "description": "Upper safety threshold; values above trigger an overflow alert."
          },
          "notify_channel": {
            "type": "string",
            "enum": [
              "cloud",
              "sms",
              "local_buzzer",
              "led_strobe"
            ],
            "description": "Dispatch mechanism when alert fires."
          }
        },
        "required": [
          "sensor_id",
          "metric"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "ble_scan",
      "description": "Perform a Bluetooth Low Energy discovery scan for nearby advertising peripherals.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "duration_seconds": {
            "type": "number",
            "description": "Duration of active or passive scanning in seconds."
          },
          "service_uuids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional list of 16-bit or 128-bit service UUID filters."
          },
          "rssi_threshold": {
            "type": "integer",
            "description": "Minimum received signal strength indicator in dBm, e.g. -85."
          },
          "active": {
            "type": "boolean",
            "description": "True for active scanning (request scan response packets), false for passive."
          }
        },
        "required": [
          "duration_seconds"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "thermal_throttle",
      "description": "Set thermal management policy, temperature limits, and active cooling parameters.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "profile": {
            "type": "string",
            "enum": [
              "conservative",
              "balanced",
              "performance",
              "emergency"
            ],
            "description": "Thermal scaling governor profile."
          },
          "max_temp_celsius": {
            "type": "number",
            "description": "Junction temperature trip point that initiates clock downscaling."
          },
          "fan_speed_pct": {
            "type": "integer",
            "description": "Manual fan duty cycle percentage (0 to 100)."
          }
        },
        "required": [
          "profile",
          "max_temp_celsius"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "camera_capture",
      "description": "Trigger onboard image capture with configured optical and encoding parameters.",
      "parameters": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "resolution": {
            "type": "string",
            "enum": [
              "640x480",
              "1280x720",
              "1920x1080",
              "2560x1440"
            ],
            "description": "Frame resolution width x height."
          },
          "format": {
            "type": "string",
            "enum": [
              "jpeg",
              "png",
              "raw_bayer"
            ],
            "description": "Output image compression format."
          },
          "flash": {
            "type": "boolean",
            "description": "Whether to fire auxiliary LED illumination during exposure."
          },
          "exposure_comp": {
            "type": "number",
            "description": "Exposure compensation value in EV stops (-2.0 to +2.0)."
          }
        },
        "required": [
          "resolution",
          "format"
        ],
        "additionalProperties": false
      }
    }
  }
]